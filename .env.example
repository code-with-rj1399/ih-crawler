OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
SPRING_PROFILES_ACTIVE=local
CRAWLER_BROWSER_HEADLESS=true

# Production / AWS
AWS_REGION=ap-south-1
DYNAMODB_TABLE=interviewhq-crawler-prod
DYNAMODB_AUTO_CREATE_TABLE=false
CRAWLER_CRON=0 0 * * * *
CRAWLER_CRON_ZONE=UTC
CRAWLER_LOOKBACK_HOURS=48
CRAWLER_MAX_CONCURRENT_TASKS=8
