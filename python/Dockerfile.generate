FROM python:3.12-slim

WORKDIR /app

COPY requirements-generate.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY generate_and_ingest.py .

RUN mkdir -p /data

ENV PYTHONUNBUFFERED=1
ENV INPUT_DIR=/data
ENV OPENAI_MODEL=gpt-5.6-terra
ENV HQ_API_URL=http://host.docker.internal:8080/api/v1/interview-experiences

ENTRYPOINT ["python", "-u", "generate_and_ingest.py"]
